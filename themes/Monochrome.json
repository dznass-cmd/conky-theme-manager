{
  "name": "Monochrome",
  "font_family": "Noto Sans Mono",
  "font_size": 10,
  "alignment": "top_right",
  "bg_color": "#111111",
  "bg_opacity": 230,
  "text_color": "#FFFFFF",
  "accent1": "#AAAAAA",
  "accent2": "#666666",
  "accent3": "#DDDDDD",
  "title_color": "#FFFFFF",
  "border_color": "#555555",
  "border_width": 1,
  "gap_x": 40,
  "gap_y": 40,
  "min_width": 200,
  "max_width": 280,
  "min_height": 120,
  "update_interval": 5.0,
  "title_size": 14,
  "title_text": "${nodename}",
  "content": "${color}${font Noto Sans Mono:bold:size=14}${nodename}${font}\n${color2}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500${color}\n${color1}wm:${color}    xfwm4\n${color1}cpu:${color}   ${cpu cpu0}%\n${color1}mem:${color}   ${mem} / ${memmax}\n${color1}disk:${color}  ${fs_used /} / ${fs_size /}\n${color2}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500${color}\n${color3}${time %Y-%m-%d %H:%M}${color}\n${color2}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500${color}"
}