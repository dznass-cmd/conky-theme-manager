{
  "name": "Solarized",
  "font_family": "Noto Sans Mono",
  "font_size": 10,
  "alignment": "top_left",
  "bg_color": "#002B36",
  "bg_opacity": 200,
  "text_color": "#839496",
  "accent1": "#CB4B16",
  "accent2": "#B58900",
  "accent3": "#2AA198",
