{
  "name": "Minimal Light",
  "font_family": "Noto Sans Mono",
  "font_size": 11,
  "alignment": "top_right",
  "bg_color": "#F5F5F5",
  "bg_opacity": 200,
  "text_color": "#333333",
  "accent1": "#2196F3",
  "accent2": "#607D8B",
  "accent3": "#4CAF50",
  "title_color": "#1565C0",
  "border_color": "#90CAF9",
  "border_width": 0,
  "gap_x": 30,
  "gap_y": 30,
  "min_width": 200,
  "max_width": 280,
  "min_height": 100,
  "update_interval": 5.0,
  "title_size": 14,
  "title_text": "${nodename}",
  "content": "${color1}${font Noto Sans Mono:bold:size=14}${nodename}${font}${color}\n${color1}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500${color}\n${color2}wm:${color}    xfwm4\n${color2}cpu:${color}   ${cpu cpu0}%\n${color2}mem:${color}   ${mem} / ${memmax}\n${color3}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500${color}\n${color3}${time %d/%m/%Y}  ${time %H:%M}${color}\n${color1}\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500${color}"
}